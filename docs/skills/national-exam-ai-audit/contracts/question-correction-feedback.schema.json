{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.tw-national-exam-catalog/contracts/question-correction-feedback.schema.json",
  "title": "Question correction feedback event",
  "description": "Append-only before/after feedback for a human correction or a deterministic three-evidence repair. It is advisory training material, never an active rule.",
  "type": "object",
  "required": [
    "schema_version",
    "feedback_id",
    "candidate_key",
    "source_kind",
    "scope",
    "changed_fields",
    "before",
    "after",
    "diff",
    "evidence",
    "promotion_policy"
  ],
  "properties": {
    "schema_version": {"const": "question_correction_feedback_v1"},
    "feedback_id": {"type": "string", "pattern": "^feedback:[a-f0-9]{24}$"},
    "candidate_key": {"type": "string", "minLength": 1, "maxLength": 300},
    "question_number": {"type": "string", "maxLength": 40},
    "run_id": {"type": "string", "maxLength": 300},
    "revision_id": {"type": "string", "maxLength": 300},
    "source_kind": {"enum": ["human_correction", "three_evidence_correction"]},
    "scope": {"enum": ["question", "group", "visual", "answer"]},
    "lane": {"type": "string", "maxLength": 80},
    "actor_kind": {"enum": ["human", "deterministic_system"]},
    "reviewer": {"type": "string", "maxLength": 200},
    "event_ref": {"type": "string", "maxLength": 300},
    "change_class": {"type": "string", "maxLength": 80},
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["stem", "stem_markup", "options", "answer", "answer_payload", "group_ref", "group_sequence_no", "image_refs", "stem_image", "answer_image_refs", "visual_review"]}
    },
    "before": {"type": "object"},
    "after": {"type": "object"},
    "diff": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "before", "after"],
        "properties": {
          "field": {"type": "string"},
          "before": {},
          "after": {}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string", "maxLength": 100},
          "family": {"type": "string", "maxLength": 200},
          "source": {"type": "string", "maxLength": 200},
          "reference": {"type": "string", "maxLength": 500},
          "locator": {"type": "string", "maxLength": 500},
          "page": {"type": ["string", "integer", "null"]},
          "sha256": {"type": "string", "maxLength": 128},
          "status": {"type": "string", "maxLength": 80}
        },
        "additionalProperties": false
      }
    },
    "evidence_summary": {"type": "object"},
    "ai_task": {"type": "object"},
    "promotion_policy": {
      "type": "object",
      "required": ["advisory_only", "rule_candidate_only", "requires_negative_controls", "requires_owner_approval", "may_write_skill_directly", "may_activate_rule_directly"],
      "properties": {
        "advisory_only": {"const": true},
        "rule_candidate_only": {"const": true},
        "requires_negative_controls": {"const": true},
        "requires_owner_approval": {"const": true},
        "may_write_skill_directly": {"const": false},
        "may_activate_rule_directly": {"const": false}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
