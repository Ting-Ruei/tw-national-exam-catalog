# Ryzen AI Max 395 target-host template (Ubuntu Linux).
# Copy to .env on the target only, replace every CHANGE_ME value, and keep .env out of Git.

TW_EXAM_REPO=/srv/tw-national-exam-catalog
ASSET_ROOT=/data/tw-national-exam-catalog/國考題資料夾
ASSET_CONTAINER_ROOT=/data/tw-national-exam-catalog/國考題資料夾
MINERU_BIN=/opt/tw-national-exam/mineru/bin/mineru
MIGRATION_SNAPSHOT_ROOT=/backup/tw-national-exam-catalog/migration_snapshots

POSTGRES_BIND=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=tw_national_exam_dev
POSTGRES_USER=national_exam
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18
DATABASE_URL=postgresql://national_exam:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54329/tw_national_exam_dev
REVIEW_UI_DATABASE_URL=postgresql://national_exam:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/tw_national_exam_dev

# Bind the published ports to the target's fixed LAN/VPN address, not every interface.
REVIEW_UI_BIND=CHANGE_ME_NEW_LAN_IP
REVIEW_UI_PORT=8765
REVIEW_UI_MOBILE_PORT=8766
REVIEW_UI_BACKEND=sql
REVIEW_UI_WRITE_LEGACY_JSONL=0
REVIEW_UI_DEFER_FORMAL_SYNC=1

# Do not change these primary-authority values until the cutover is accepted.
REVIEW_PRIMARY_UI_URL=http://CHANGE_ME_NEW_LAN_IP:8765/
REVIEW_PRIMARY_MOBILE_UI_URL=http://CHANGE_ME_NEW_LAN_IP:8766/
REVIEW_PRIMARY_DB_HOST=127.0.0.1
REVIEW_PRIMARY_DB_PORT=54329
REVIEW_PRIMARY_PROJECT_ROOT=/srv/tw-national-exam-catalog
REVIEW_PRIMARY_SSH_USER=CHANGE_ME
REVIEW_PRIMARY_SSH_KEY=/home/CHANGE_ME/.ssh/id_ed25519_tw_exam

OLLAMA_BASE_URL=http://127.0.0.1:11434
MINERU_METHOD=ocr
MINERU_BACKEND=vlm-engine
MINERU_IMAGE_ANALYSIS=false

# Optional cloud advisory channel. Leave blank when unused; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_REVIEW_TIMEOUT=45
