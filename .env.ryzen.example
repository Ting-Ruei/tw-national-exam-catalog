# AI395 host template. Production uses the host-managed mode-600 file
# /etc/ai395/tw-national-exam-catalog/production.env; do not overwrite it with
# this example. Replace every CHANGE_ME value and keep real secrets out of Git.

TW_EXAM_REPO=/home/tim/src/tw-national-exam-catalog
ASSET_ROOT=/srv/ai395/data/tw-national-exam-catalog/main
ASSET_CONTAINER_ROOT=/assets
MINERU_BIN=CHANGE_ME_AI395_MINERU_BIN
MIGRATION_SNAPSHOT_ROOT=/srv/ai395/backups/tw-national-exam-catalog/migration_snapshots

CATALOG_RUNTIME_SSH_ALIAS=ai395
CATALOG_RUNTIME_PROJECT_ROOT=/home/tim/src/tw-national-exam-catalog
CATALOG_RUNTIME_CONTROL=/srv/ai395/stacks/tw-national-exam-catalog/production/ai395_catalog_production.sh
CATALOG_RUNTIME_UI_URL=http://192.168.10.90:8765/
CATALOG_RUNTIME_MOBILE_UI_URL=http://192.168.10.90:8766/mobile/
CATALOG_RUNTIME_DB_HOST=127.0.0.1
CATALOG_RUNTIME_DB_PORT=54329
CATALOG_RUNTIME_LOCAL_DB_PORT=54330
CATALOG_RUNTIME_WRITE_ALLOWED=1

POSTGRES_BIND=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=tw_national_exam_dev
POSTGRES_USER=national_exam
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18
DATABASE_URL=postgresql://CHANGE_ME_APP_ROLE:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54329/tw_national_exam_dev
REVIEW_UI_DATABASE_URL=postgresql://CHANGE_ME_APP_ROLE:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/tw_national_exam_dev

# Production Review UI binds only the fixed LAN address and requires Basic Auth.
REVIEW_UI_BIND=192.168.10.90
REVIEW_UI_PORT=8765
REVIEW_UI_MOBILE_PORT=8766
REVIEW_UI_BACKEND=sql
REVIEW_UI_WRITE_LEGACY_JSONL=0
REVIEW_UI_DEFER_FORMAL_SYNC=1

# Production authority moved to this host on 2026-08-09.
REVIEW_PRIMARY_UI_URL=http://192.168.10.90:8765/
REVIEW_PRIMARY_MOBILE_UI_URL=http://192.168.10.90:8766/mobile/
REVIEW_PRIMARY_DB_HOST=127.0.0.1
REVIEW_PRIMARY_DB_PORT=54329
REVIEW_PRIMARY_PROJECT_ROOT=/home/tim/src/tw-national-exam-catalog
REVIEW_PRIMARY_SSH_USER=tim
REVIEW_PRIMARY_SSH_KEY=CHANGE_ME_ONLY_IF_REMOTE_SSH_IS_REQUIRED

OLLAMA_BASE_URL=http://127.0.0.1:11434
MINERU_METHOD=ocr
MINERU_BACKEND=vlm-engine
MINERU_IMAGE_ANALYSIS=false

# Optional cloud advisory channel. Leave blank when unused; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_REVIEW_TIMEOUT=45
