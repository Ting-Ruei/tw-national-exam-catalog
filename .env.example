# AI395 is the default runtime maintenance target. The local Compose stack is
# a loopback-only fallback during the retirement window.
CATALOG_RUNTIME_SSH_ALIAS=ai395
CATALOG_RUNTIME_PROJECT_ROOT=/home/tim/src/tw-national-exam-catalog
CATALOG_RUNTIME_CONTROL=/home/tim/ai395-catalog-restore-drill.sh
CATALOG_RUNTIME_UI_URL=http://127.0.0.1:8875/
CATALOG_RUNTIME_MOBILE_UI_URL=http://127.0.0.1:8876/
CATALOG_RUNTIME_DB_HOST=127.0.0.1
CATALOG_RUNTIME_DB_PORT=54330
CATALOG_RUNTIME_WRITE_ALLOWED=0
CATALOG_LOCAL_ROLE=legacy_fallback
CATALOG_LOCAL_RETIRE_AFTER=2026-09-08
CATALOG_RESTART_POLICY=no

POSTGRES_HOST=localhost
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=tw_national_exam_dev
POSTGRES_USER=national_exam
POSTGRES_PASSWORD=national_exam_dev_password
POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18
DATABASE_URL=postgresql://national_exam:national_exam_dev_password@localhost:54329/tw_national_exam_dev
REVIEW_UI_BACKEND=sql
REVIEW_UI_WRITE_LEGACY_JSONL=0
REVIEW_UI_DEFER_FORMAL_SYNC=1
REVIEW_UI_BIND=127.0.0.1
REVIEW_UI_PORT=8765
REVIEW_UI_MOBILE_PORT=8766

# Host path mounted into Review UI; container code sees ASSET_CONTAINER_ROOT.
ASSET_ROOT=./國考題資料夾
ASSET_CONTAINER_ROOT=/workspace/國考題資料夾

# Portable worker paths for the incremental MOEX -> MinerU pipeline.
# MINERU_BIN=/absolute/path/to/venv_mineru/bin/mineru

# Production writer authority remains on Mac Studio until a separately approved cutover.
# Do not point these write-oriented values at the AI395 restore drill.
REVIEW_PRIMARY_UI_URL=http://192.168.10.70:8765/
REVIEW_PRIMARY_MOBILE_UI_URL=http://192.168.10.70:8766/
REVIEW_PRIMARY_DB_HOST=192.168.10.70
REVIEW_PRIMARY_DB_PORT=54329
REVIEW_PRIMARY_PROJECT_ROOT=/Users/tim/tw-national-exam-catalog
REVIEW_PRIMARY_SSH_USER=tim
REVIEW_PRIMARY_SSH_KEY=/Users/tim/.ssh/id_ed25519_codex_mineru
