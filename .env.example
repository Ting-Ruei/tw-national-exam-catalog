# Current development defaults are loopback-only. No external AI or review host is
# configured here. A future deployment must define a new owner-approved contract.
CATALOG_RUNTIME_SSH_ALIAS=
CATALOG_RUNTIME_PROJECT_ROOT=
CATALOG_RUNTIME_CONTROL=
CATALOG_RUNTIME_UI_URL=http://127.0.0.1:8765/
CATALOG_RUNTIME_MOBILE_UI_URL=http://127.0.0.1:8766/mobile/
CATALOG_RUNTIME_DB_HOST=127.0.0.1
CATALOG_RUNTIME_DB_PORT=54329
CATALOG_RUNTIME_LOCAL_DB_PORT=54330
CATALOG_RUNTIME_WRITE_ALLOWED=0
CATALOG_LOCAL_ROLE=local_development
CATALOG_LOCAL_RETIRE_AFTER=
CATALOG_RESTART_POLICY=no

POSTGRES_HOST=localhost
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=54329
POSTGRES_DB=tw_national_exam_dev
POSTGRES_USER=national_exam
POSTGRES_PASSWORD=national_exam_dev_password
POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18
DATABASE_URL=postgresql://national_exam:national_exam_dev_password@localhost:54329/tw_national_exam_dev
REVIEW_UI_BACKEND=sql
REVIEW_UI_WRITE_LEGACY_JSONL=0
REVIEW_UI_DEFER_FORMAL_SYNC=1
REVIEW_UI_BIND=127.0.0.1
REVIEW_UI_PORT=8765
REVIEW_UI_MOBILE_PORT=8766

# Host path mounted into Review UI; container code sees ASSET_CONTAINER_ROOT.
ASSET_ROOT=./國考題資料夾
ASSET_CONTAINER_ROOT=/workspace/國考題資料夾

# Portable worker paths for the incremental MOEX -> MinerU pipeline.
# MINERU_BIN=/absolute/path/to/venv_mineru/bin/mineru

# There is no configured primary external writer. These loopback values are for
# isolated local schema/UI work only; they do not authorize publication.
REVIEW_PRIMARY_UI_URL=http://127.0.0.1:8765/
REVIEW_PRIMARY_MOBILE_UI_URL=http://127.0.0.1:8766/mobile/
REVIEW_PRIMARY_DB_HOST=127.0.0.1
REVIEW_PRIMARY_DB_PORT=54329
REVIEW_PRIMARY_PROJECT_ROOT=
REVIEW_PRIMARY_SSH_USER=
REVIEW_PRIMARY_SSH_KEY=
