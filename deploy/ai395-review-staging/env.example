# Copy to a local, untracked env file on AI395. Do not commit the copy.
AI395_STAGING_PROJECT_NAME=ai395-review-staging
AI395_STAGING_POSTGRES_IMAGE=pgvector/pgvector:0.8.2-pg18
AI395_STAGING_N8N_IMAGE=n8nio/n8n:latest
AI395_STAGING_DB_BIND=127.0.0.1
AI395_STAGING_DB_PORT=55439
AI395_STAGING_WORKER_BIND=127.0.0.1
AI395_STAGING_WORKER_PORT=58080
AI395_STAGING_N8N_BIND=127.0.0.1
AI395_STAGING_N8N_PORT=5680
AI395_STAGING_POSTGRES_DB=ai395_review_staging
AI395_STAGING_POSTGRES_USER=ai395_staging
# Use a staging-only password without URL-reserved characters for this first skeleton.
AI395_STAGING_POSTGRES_PASSWORD=CHANGE_ME_STAGING_ONLY
# Generate a private random value locally; this is not a repository secret.
AI395_STAGING_N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_LONG_VALUE

# The MacBook MLX endpoint stays disabled until the owner completes the
# Tailscale Serve and model probe. Keep this 0 for the first staging run.
QWEN_MLX_ENABLED=0
QWEN_MLX_BASE_URL=https://REPLACE_MACHINE.REPLACE_TAILNET.ts.net/v1
QWEN_MLX_MODEL=qwen3.8:27b-mlx

# Explicitly keep live calls off for the first mock staging run. To test the
# MacBook provider later, set both AI395_STAGING_ALLOW_LIVE_LLM=1 and
# QWEN_MLX_ENABLED=1, then submit model_mode=local_qwen_mlx.
AI395_STAGING_ALLOW_LIVE_LLM=0
AI395_STAGING_MODEL_MODE=mock
AI395_STAGING_LLM_LANE_POLICY=residual
AI395_STAGING_LLM_MAX_CALLS=20
AI395_STAGING_MODEL_TIMEOUT=120
AI395_STAGING_MODEL_MAX_TOKENS=512
