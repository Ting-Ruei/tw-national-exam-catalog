# 新版題庫審題介面 — 環境設定（複製成 .env 再改）
#
# 每個變數的預設值都寫在 compose.yaml 裡，這份檔案只是把它們列出來讓你可以覆寫。
# `deploy/qbr-review/up.sh` 會讀這份（若存在），所以不必手動 `--env-file`。

# ── 埠與綁定 ──────────────────────────────────────────────────────────────
# 綁 0.0.0.0 讓 LAN／Tailscale 上的其他裝置連進來；設 127.0.0.1 就只限本機。
REVIEW_UI_BIND=0.0.0.0
# 8774 是新管線一直在用的號碼（書籤與已安裝的 PWA 是契約），所以預設不改。
REVIEW_UI_PORT=8774

# ── 路徑（相對路徑以這份 compose 檔所在目錄為基準，`deploy/qbr-review/`）────
# ── 也可以寫絕對路徑；寫相對的比較好搬。─────────────────────────────────
# CATALOG_ROOT  程式碼（唯讀掛載）
# ASSET_ROOT    官方 PDF 語料（唯讀掛載，審題對照紙本用）
# QBR_QUEUE_DIR 要服務的佇列根目錄（唯讀掛載；`review-ui/` 是它的子目錄）
# QBR_REVIEW_LOG 人類審核紀錄（唯一可寫的檔案；必須在 QBR_QUEUE_DIR 裡面）
CATALOG_ROOT=../..
ASSET_ROOT=../../國考題資料夾
QBR_QUEUE_DIR=../../qbr/data/review-queues/live
QBR_REVIEW_LOG=../../qbr/data/review-queues/live/review-ui/question_review_events.jsonl
# ── 認證（選用）────────────────────────────────────────────────────────────
# 兩個都設才會生效。在 LAN 上開服務時建議設起來，因為 `--review-backend jsonl` 下任何能連到
# 這個埠的人都能寫審核紀錄。留空 = 不驗證（只在單機或可信網路這樣用）。
REVIEW_UI_BASIC_AUTH_USERNAME=
REVIEW_UI_BASIC_AUTH_PASSWORD=

# ── 其他 ──────────────────────────────────────────────────────────────────
REVIEW_UI_IMAGE=tw-national-exam-qbr-review-ui:local
# 設 1 就完全唯讀（連審核紀錄都不能寫），適合拿來「只看不改」的示範或截圖。
REVIEW_UI_READ_ONLY=0
REVIEW_UI_POST_RATE_LIMIT_PER_MINUTE=240
